{
  "name": "meetings-bot",
  "version": "0.1.0",
  "description": "Shadow assistant that joins Google Meet calls, answers when addressed, and writes notes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "meetings-bot": "dist/bin/meetings-bot.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/bin/meetings-bot.ts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "commander": "13.1.0",
    "fast-glob": "3.3.3",
    "ignore": "7.0.14",
    "kokoro-js": "1.2.1",
    "msedge-tts": "2.1.0",
    "pino": "9.14.0",
    "puppeteer": "24.43.1",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
